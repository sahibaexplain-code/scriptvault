# ─────────────────────────────────────────────────────────────
# ScriptVault environment variables
# Copy this file to .env.local for local development, and add the
# same keys in Vercel → Project → Settings → Environment Variables.
#
# Leave the Supabase keys empty to run the site in DEMO MODE
# (sample catalogue, simulated checkout, no real accounts or payments).
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (use rzp_test_ keys first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SECRET. Server only.
RAZORPAY_KEY_SECRET=
# SECRET. Razorpay → Webhooks → the secret you typed when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=
